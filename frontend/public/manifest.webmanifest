{
  "name": "WareTrack Pro",
  "short_name": "WareTrack",
  "description": "Warehouse delivery and dispatch tracking",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F6F8FB",
  "theme_color": "#2F5778",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My Deliveries", "url": "/my-deliveries", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Scanner", "url": "/scanner", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Track an order", "url": "/track", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
