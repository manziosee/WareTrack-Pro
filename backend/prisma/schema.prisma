// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      UserRole @default(WAREHOUSE_STAFF)
  status    UserStatus @default(ACTIVE)
  lastLogin DateTime? @map("last_login")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  createdOrders    DeliveryOrder[] @relation("CreatedBy")
  createdDispatches Dispatch[] @relation("CreatedBy")
  driverProfile    Driver?
  managedDrivers   Driver[] @relation("ManagerDrivers")
  managedVehicles  Vehicle[] @relation("ManagerVehicles")
  inventoryHistory InventoryHistory[]
  notificationPreferences NotificationPreferences?
  systemConfiguration SystemConfiguration?
  reportSettings ReportSettings?
  notifications Notification[]
  sentMessages ChatMessage[] @relation("SentMessages")
  receivedMessages ChatMessage[] @relation("ReceivedMessages")
  preferences UserPreferences?
  barcodeGenerations BarcodeLog[]

  @@map("users")
}

model InventoryItem {
  id           Int      @id @default(autoincrement())
  name         String
  code         String   @unique
  category     String
  quantity     Int      @default(0)
  minQuantity  Int      @default(0) @map("min_quantity")
  unit         String
  unitCategory String   @map("unit_category")
  location     String
  barcode      String?
  unitPrice    Decimal  @default(0) @map("unit_price")
  status       InventoryStatus @default(ACTIVE)
  supplier     String?
  description  String?
  lastUpdated  DateTime @default(now()) @map("last_updated")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  orderItems       OrderItem[]
  inventoryHistory InventoryHistory[]
  forecasts        InventoryForecast[]
  barcodeLogs      BarcodeLog[]

  @@map("inventory_items")
}

model Vehicle {
  id              Int      @id @default(autoincrement())
  managerId       Int?     @map("manager_id")
  plateNumber     String   @unique @map("plate_number")
  type            String
  capacity        Int
  status          VehicleStatus @default(AVAILABLE)
  lastMaintenance DateTime? @map("last_maintenance")
  fuelType        String?  @map("fuel_type")
  vehicleModel    String?  @map("vehicle_model")
  year            Int?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  manager             User? @relation("ManagerVehicles", fields: [managerId], references: [id])
  orders              DeliveryOrder[]
  dispatches          Dispatch[]
  currentDrivers      Driver[]
  maintenanceRecords  MaintenanceRecord[]
  healthRecords       VehicleHealth[]

  @@map("vehicles")
}

model Driver {
  id                Int      @id @default(autoincrement())
  userId            Int?     @unique @map("user_id")
  managerId         Int?     @map("manager_id")
  name              String
  email             String?
  licenseNumber     String   @unique @map("license_number")
  phone             String
  status            DriverStatus @default(AVAILABLE)
  currentVehicleId  Int?     @map("current_vehicle_id")
  experience        Int?
  rating            Decimal?
  address           String?
  dateOfBirth       DateTime? @map("date_of_birth")
  hireDate          DateTime? @map("hire_date")
  licenseExpiry     DateTime? @map("license_expiry")
  emergencyContact  String?  @map("emergency_contact")
  emergencyContactName String? @map("emergency_contact_name")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  user           User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  manager        User? @relation("ManagerDrivers", fields: [managerId], references: [id])
  currentVehicle Vehicle? @relation(fields: [currentVehicleId], references: [id])
  orders         DeliveryOrder[]
  dispatches     Dispatch[]
  achievements   DriverAchievement[]
  leaderboard    DriverLeaderboard[]
  ratings        CustomerRating[]

  @@map("drivers")
}

model DeliveryOrder {
  id                   Int      @id @default(autoincrement())
  orderNumber          String   @unique @map("order_number")
  customerId           Int      @map("customer_id")
  customerName         String   @map("customer_name")
  deliveryAddress      String   @map("delivery_address")
  contactNumber        String   @map("contact_number")
  priority             OrderPriority @default(MEDIUM)
  status               OrderStatus @default(PENDING)
  orderType            String   @map("order_type")
  paymentMethod        String   @map("payment_method")
  totalAmount          Decimal  @default(0) @map("total_amount")
  deliveryInstructions String?  @map("delivery_instructions")
  driverId             Int?     @map("driver_id")
  vehicleId            Int?     @map("vehicle_id")
  createdBy            Int      @map("created_by")
  scheduledDate        DateTime? @map("scheduled_date")
  deliveredAt          DateTime? @map("delivered_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  // Relations
  driver       Driver? @relation(fields: [driverId], references: [id])
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id])
  createdByUser User @relation("CreatedBy", fields: [createdBy], references: [id])
  items        OrderItem[]
  dispatches   Dispatch[]
  proofs       DeliveryProof[]
  ratings      CustomerRating[]

  @@map("delivery_orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  itemId    Int      @map("item_id")
  itemName  String   @map("item_name")
  quantity  Int
  unit      String
  unitPrice Decimal  @map("unit_price")
  totalPrice Decimal @map("total_price")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  order DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  InventoryItem @relation(fields: [itemId], references: [id])

  @@map("order_items")
}

model Dispatch {
  id                Int      @id @default(autoincrement())
  orderId           Int      @map("order_id")
  driverId          Int      @map("driver_id")
  vehicleId         Int      @map("vehicle_id")
  scheduledDate     DateTime @map("scheduled_date")
  dispatchedAt      DateTime? @map("dispatched_at")
  estimatedDelivery DateTime? @map("estimated_delivery")
  actualDelivery    DateTime? @map("actual_delivery")
  fuelAllowance     Decimal  @default(0) @map("fuel_allowance")
  route             String?
  notes             String?
  status            DispatchStatus @default(PENDING)
  createdBy         Int      @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  order         DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver        Driver @relation(fields: [driverId], references: [id])
  vehicle       Vehicle @relation(fields: [vehicleId], references: [id])
  createdByUser User @relation("CreatedBy", fields: [createdBy], references: [id])
  proof         DeliveryProof?

  @@map("dispatches")
}

model MaintenanceRecord {
  id                   Int      @id @default(autoincrement())
  vehicleId            Int      @map("vehicle_id")
  type                 String
  description          String
  cost                 Decimal  @default(0)
  odometerReading      Int?     @map("odometer_reading")
  nextServiceOdometer  Int?     @map("next_service_odometer")
  nextServiceDate      DateTime? @map("next_service_date")
  performedBy          String?  @map("performed_by")
  notes                String?
  scheduledDate        DateTime @map("scheduled_date")
  completedDate        DateTime? @map("completed_date")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  // Relations
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("maintenance_records")
}

model InventoryHistory {
  id               Int      @id @default(autoincrement())
  itemId           Int      @map("item_id")
  action           String   // stock_in, stock_out, adjustment
  quantity         Int
  previousQuantity Int      @map("previous_quantity")
  newQuantity      Int      @map("new_quantity")
  orderId          Int?     @map("order_id")
  notes            String?
  performedBy      Int      @map("performed_by")
  performedAt      DateTime @default(now()) @map("performed_at")

  // Relations
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  performedByUser User @relation(fields: [performedBy], references: [id])

  @@map("inventory_history")
}

model NotificationPreferences {
  id              Int     @id @default(autoincrement())
  userId          Int     @unique @map("user_id")
  emailEnabled    Boolean @default(true) @map("email_enabled")
  smsEnabled      Boolean @default(false) @map("sms_enabled")
  orderUpdates    Boolean @default(true) @map("order_updates")
  lowStockAlerts  Boolean @default(true) @map("low_stock_alerts")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model SystemConfiguration {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique @map("user_id")
  language    String  @default("en")
  timezone    String  @default("UTC")
  dateFormat  String  @default("MM/DD/YYYY") @map("date_format")
  currency    String  @default("RWF")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("system_configuration")
}

model ReportSettings {
  id                Int     @id @default(autoincrement())
  userId            Int     @unique @map("user_id")
  autoReportsEnabled Boolean @default(false) @map("auto_reports_enabled")
  reportFrequency   String  @default("weekly") @map("report_frequency")
  reportFormat      String  @default("pdf") @map("report_format")
  emailReports      Boolean @default(true) @map("email_reports")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("report_settings")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  type      NotificationType
  title     String
  message   String
  severity  NotificationSeverity @default(INFO)
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// Enums
enum UserRole {
  ADMIN
  WAREHOUSE_STAFF
  DISPATCH_OFFICER
  DRIVER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum OrderPriority {
  HIGH
  MEDIUM
  LOW
}

enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  UNAVAILABLE
}

enum DriverStatus {
  AVAILABLE
  ON_DUTY
  OFF_DUTY
}

enum InventoryStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum DispatchStatus {
  PENDING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum NotificationType {
  SYSTEM
  LOW_STOCK
  ORDER_UPDATE
  DELIVERY_COMPLETE
  WELCOME
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model DeliveryProof {
  id               Int      @id @default(autoincrement())
  dispatchId       Int      @unique @map("dispatch_id")
  orderId          Int      @map("order_id")
  photoUrl         String?  @map("photo_url")
  signatureData    String?  @map("signature_data")
  confirmationCode String   @unique @map("confirmation_code")
  recipientName    String?  @map("recipient_name")
  notes            String?
  latitude         Decimal? @db.Decimal(10, 8)
  longitude        Decimal? @db.Decimal(11, 8)
  createdAt        DateTime @default(now()) @map("created_at")

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  order    DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("delivery_proofs")
}

model ChatMessage {
  id          Int      @id @default(autoincrement())
  senderId    Int      @map("sender_id")
  receiverId  Int?     @map("receiver_id")
  roomId      String?  @map("room_id")
  message     String
  messageType String   @default("text") @map("message_type")
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  sender   User  @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User? @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([senderId])
  @@map("chat_messages")
}

model DriverAchievement {
  id              Int      @id @default(autoincrement())
  driverId        Int      @map("driver_id")
  achievementType String   @map("achievement_type")
  title           String
  description     String?
  points          Int      @default(0)
  earnedAt        DateTime @default(now()) @map("earned_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@map("driver_achievements")
}

model DriverLeaderboard {
  id              Int      @id @default(autoincrement())
  driverId        Int      @map("driver_id")
  month           String
  totalDeliveries Int      @default(0) @map("total_deliveries")
  totalRevenue    Decimal  @default(0) @map("total_revenue") @db.Decimal(12, 2)
  successRate     Decimal  @default(0) @map("success_rate") @db.Decimal(5, 2)
  points          Int      @default(0)
  rank            Int?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, month])
  @@map("driver_leaderboard")
}

model InventoryForecast {
  id              Int      @id @default(autoincrement())
  itemId          Int      @map("item_id")
  forecastDate    DateTime @map("forecast_date") @db.Date
  predictedDemand Int      @map("predicted_demand")
  confidenceLevel Decimal? @map("confidence_level") @db.Decimal(5, 2)
  seasonalFactor  Decimal? @map("seasonal_factor") @db.Decimal(5, 2)
  trendFactor     Decimal? @map("trend_factor") @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, forecastDate])
  @@map("inventory_forecasts")
}

model SmartAlert {
  id          Int       @id @default(autoincrement())
  alertType   String    @map("alert_type")
  entityType  String?   @map("entity_type")
  entityId    Int?      @map("entity_id")
  title       String
  message     String
  severity    String    @default("INFO")
  triggerDate DateTime  @map("trigger_date")
  resolved    Boolean   @default(false)
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([triggerDate, resolved])
  @@map("smart_alerts")
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String?
  address   String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  ratings CustomerRating[]

  @@map("customers")
}

model CustomerRating {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  orderId    Int      @map("order_id")
  driverId   Int      @map("driver_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver   Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([customerId, orderId])
  @@map("customer_ratings")
}

model VehicleHealth {
  id                        Int       @id @default(autoincrement())
  vehicleId                 Int       @map("vehicle_id")
  odometerReading           Int       @map("odometer_reading")
  fuelEfficiency            Decimal?  @map("fuel_efficiency") @db.Decimal(5, 2)
  engineHours               Int?      @map("engine_hours")
  healthScore               Int?      @map("health_score")
  predictedMaintenanceDate  DateTime? @map("predicted_maintenance_date") @db.Date
  maintenanceCostEstimate   Decimal?  @map("maintenance_cost_estimate") @db.Decimal(10, 2)
  recordedAt                DateTime  @default(now()) @map("recorded_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_health")
}

model UserPreferences {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique @map("user_id")
  theme      String   @default("light")
  autoTheme  Boolean  @default(false) @map("auto_theme")
  language   String   @default("en")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model BarcodeLog {
  id          Int      @id @default(autoincrement())
  itemId      Int      @map("item_id")
  barcode     String
  format      String   @default("CODE128")
  generatedBy Int?     @map("generated_by")
  generatedAt DateTime @default(now()) @map("generated_at")

  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  generator User?         @relation(fields: [generatedBy], references: [id])

  @@index([itemId])
  @@map("barcode_logs")
}
