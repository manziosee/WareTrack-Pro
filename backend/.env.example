NODE_ENV=development
PORT=5000

# PostgreSQL connection string (Prisma Postgres in production)
DATABASE_URL=postgresql://postgres:password@localhost:5432/waretrack

# At least 32 random characters in production: openssl rand -hex 48
JWT_SECRET=change-me
JWT_EXPIRE=7d

# Browser origins allowed by CORS (FRONTEND_URL plus optional comma-separated extras)
FRONTEND_URL=http://localhost:3001
# Public frontend origin used to build links in outgoing emails.
PUBLIC_APP_URL=https://ware-track-pro.vercel.app
# CORS_ORIGINS=https://staging.example.com

# EmailJS (login OTP and notification emails)
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# General API rate limit per IP (login/OTP have stricter built-in limits)
API_RATE_LIMIT_PER_15_MIN=1000
